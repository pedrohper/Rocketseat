generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Org {
  id       String  @id @default(uuid())
  email    String  @unique
  password String?
  address  String?
  phone    String?

  pets     Pet[]

  @@map("orgs")
}

model Pet {
  id      String   @id @default(uuid())
  name    String
  age     Int?
  size    Decimal?

  org_id  String
  org     Org      @relation(fields: [org_id], references: [id])

  @@map("pets")
}